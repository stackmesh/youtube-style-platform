{
	auto_https off
	admin off
}

# Local development only. Vite needs inline scripts and a websocket.
# The production edge in a later stage serves built assets with the stricter policy.
http://localhost, http://127.0.0.1 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
	}

	@api path /api/* /health/* /docs /docs/* /redoc /redoc/* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:5173
	}
}

http://s3.localhost {
	reverse_proxy seaweedfs:8333 {
		header_up Host {host}
	}
}
