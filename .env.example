# Local development placeholders. Copy to .env.
# Do not put S3_ADMIN_ACCESS_KEY or S3_ADMIN_SECRET_KEY here.

DATABASE_URL=postgresql+psycopg://youtube:youtube@postgres:5432/youtube
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT_URL=http://s3.localhost
S3_ACCESS_KEY=media-app
S3_SECRET_KEY=media-app-local-secret
S3_BUCKET=media
S3_REGION=us-east-1
S3_BUCKET_QUOTA_BYTES=10737418240

PART_SIZE_BYTES=16777216
MAX_PARTS=512
UPLOAD_PART_URL_TTL_SECONDS=1200

JWT_SECRET=dev-only-jwt-secret-change-me-32b!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

PUBLIC_APP_URL=http://localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost
# Production sets this to the public host and the s3 host. Empty keeps local development open.
TRUSTED_HOSTS=
DOCS_ENABLED=true

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

MAX_UPLOAD_BYTES=2147483648
MAX_DURATION_SECONDS=3600
DEFAULT_QUOTA_BYTES=10737418240
MAX_ACTIVE_UPLOADS=2
FFMPEG_CONCURRENCY=1
WORK_DIR=/var/lib/media-work
PLAYBACK_SEGMENT_TTL_SECONDS=120

STORAGE_STARTUP_CHECK=true
VITE_API_BASE_URL=
